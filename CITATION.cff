version: 0.1.0
date-released: 2026-10-22
license: Apache-2.0
repository-code: "https://github.com/WithPrecedent/fjc_biographies"
url: "https://WithPrecedent.github.io/fjc_biographies"
keywords:
  - empirical legal studies
  - Federal Judicial Center
  - federal judges
  - judicial biographies
  - judicial common space
  - law
  - martin-quinn scores
